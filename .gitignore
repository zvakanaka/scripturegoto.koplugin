# The whole KO_HOME dev instance is regenerated by run-test.sh and contains
# only local, machine-specific state (absolute paths under your home dir, a
# random device id, window position, reading history/statistics, etc.) -
# none of it is meant to be committed. See README's "Dev environment"
# section for how to (re)configure it after a fresh checkout.
/vendor/koreader-home/
*.log
*.sdr/

# Real public-domain Gutenberg EPUBs used for manual testing against real
# edition quirks - not hand-built fixtures, so not committed; redownload
# from gutenberg.org if missing (see README's "Dev environment" section).
/test-books/kjv-gutenberg.epub
/test-books/kjv-10900.epub
/test-books/Smith, Joseph, Jr. - The Book of Mormon *.epub

# tools/demo-gifs' build output (built demo.epub, recorded frames, logs) -
# regenerated by run.sh, not meant to be committed. See its README.md.
/tools/demo-gifs/build/
__pycache__/
